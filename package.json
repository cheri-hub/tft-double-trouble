{
  "name": "double-trouble-tft",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "build": "pnpm --filter desktop build",
    "test": "pnpm test:config && pnpm test:catalog-sync && pnpm --filter @double-trouble/domain vitest run && pnpm --filter @double-trouble/server vitest run && pnpm --filter desktop vitest run",
    "test:config": "node --test scripts/build-env.test.mjs",
    "test:catalog-sync": "node --test scripts/sync-catalog.test.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "check:functions": "node scripts/check-functions.mjs",
    "test:integration": "deno test --allow-env --allow-net tests/integration/supabase-contract.test.ts",
    "test:e2e": "playwright test",
    "typecheck:e2e": "pnpm --filter desktop exec tsc -p ../../tsconfig.e2e.json"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "22.20.1"
  }
}
