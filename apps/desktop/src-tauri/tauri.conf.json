{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Double Trouble TFT",
  "version": "0.1.0",
  "identifier": "com.doubletrouble.tft",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Double Trouble TFT",
        "width": 720,
        "height": 560,
        "minWidth": 320,
        "minHeight": 420,
        "center": true,
        "decorations": true,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
